{
  // Generated by: claude-sonnet-4-20250514
  // Date: 2026-04-14
  "name": "npg-irods-python",

  // Use docker-compose so the iRODS and MySQL sidecars spin up alongside the dev container
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/app",

  // Features available inside the container
  "features": {
    // Git is already in the image; this ensures the latest version and credential helpers
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // VS Code extensions that are useful for this project
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.pyenv/shims/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["--it"],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Forward the iRODS port so icommands work from the host if needed
  "forwardPorts": [1247],

  // Install the package in editable mode after the container starts so that
  // source changes are reflected immediately without a reinstall
  "postStartCommand": "pip install --no-cache-dir -e . 2>&1 | tail -5 && echo 'Dev container ready. Run: pytest --it'",

  // Run as the non-root appuser that the Dockerfile already creates
  "remoteUser": "appuser",

  "remoteEnv": {
    "IRODS_ENVIRONMENT_FILE": "/app/tests/.irods/irods_environment.json",
    "IRODS_PASSWORD": "irods"
  }
}